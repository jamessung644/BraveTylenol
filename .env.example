# Copy this file to .env for local `make run` usage.
# Keep the real credential only in the untracked .env file or your shell.
# LUNIT_FM_API_KEY=replace-with-your-runtime-credential

LUNIT_FM_API_URL=https://model.hackathon.lunit.io
LUNIT_FM_MODEL=Lunit/L2-preview
LUNIT_MCP_URL=https://mcp.hackathon.lunit.io/mcp
HARNESS_MODE=rag
HARNESS_LOG_LEVEL=INFO
MAX_TOOL_CALLS=4
L2_MAX_ATTEMPTS=3
UPSTREAM_TIMEOUT_SECONDS=150
MAX_TOOL_RESULT_CHARS=12000
MAX_EVIDENCE_CHARS=32000

# Local Uvicorn process settings (not application settings).
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
